# ------------------------------------------------------------------------------
# Terraform
# ------------------------------------------------------------------------------

# provider と module のキャッシュ。init のたびに再生成される。
.terraform/

# **state を追跡しない。** state は sensitive な値を平文で保持するため、1度の誤コミットで
# 全量が漏れる。正は S3 backend が持つ（ADR-0017）。
*.tfstate
*.tfstate.*
*.tfstate.backup

# plan の成果物。sensitive な値を平文で含むため、artifact にも残さない。
*.tfplan
*.tfplan.*
plan.out

# crash log。スタックに変数の中身が載る。
crash.log
crash.*.log

# 変数ファイル。値は環境ごとに異なり、秘密を含み得る。値の正は AWS 側の
# パラメータストアか CI の変数であって、リポジトリではない。
*.tfvars
*.tfvars.json

# 開発者が一時的に差し込む上書き。共有すると「読んだとおりに動かない」構成になる。
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI の設定。資格情報を含み得る。
.terraformrc
terraform.rc

# lock file は test と example の root（実際に init を行う単位）でのみ管理する。
# 再利用単位の module ディレクトリでは持たない（ADR-0008 決定9）。
modules/**/.terraform.lock.hcl

# ------------------------------------------------------------------------------
# 運用機構（scripts/）
# ------------------------------------------------------------------------------

# make が組み立てるツールのバイナリ。派生物であり、失っても費用がゼロ。
tmp/

# ------------------------------------------------------------------------------
# コンテナで解決する依存
# ------------------------------------------------------------------------------

# npm エコシステムの道具はコンテナが持つ（ADR-0023 決定4）。ホストの解決結果を
# 持ち込むと、コンテナ（linux）とホスト（darwin）でプラットフォーム別バイナリが食い違う。
node_modules/

# ------------------------------------------------------------------------------
# 資格情報と環境
# ------------------------------------------------------------------------------

# AWS の資格情報が置かれ得る場所。
.aws/
*.pem

# 環境変数ファイル。追跡するのは、値を持たない雛形だけ。
.env
.env.*
!.env.example

# ------------------------------------------------------------------------------
# OS / エディタ
# ------------------------------------------------------------------------------

.DS_Store
*.swp
