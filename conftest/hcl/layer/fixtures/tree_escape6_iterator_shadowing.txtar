-- modules/a/main.tf --
resource "aws_s3_bucket" "this" {}

resource "aws_s3_bucket_policy" "this" {
  bucket = concat([for var in aws_s3_bucket.this : var.id], [var.y])[0]
}
-- modules/a/tests/ok.tftest.hcl --
run "ok" {
  command = plan
}
