-- env/dev/main.tf --
module "u" {
  source = "../../usecases/u"
}
-- modules/a/main.tf --
resource "aws_s3_bucket" "this" {}

resource "aws_s3_bucket_policy" "this" {
  bucket = concat([for aws_iam_role in [aws_s3_bucket.this.id] : aws_iam_role], [aws_iam_role.r.arn])[0]
}
-- modules/a/tests/ok.tftest.hcl --
run "ok" {
  command = plan
}
-- usecases/u/main.tf --
module "a" {
  source = "../../modules/a"
}
