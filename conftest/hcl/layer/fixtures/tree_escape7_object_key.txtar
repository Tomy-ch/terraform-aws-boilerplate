-- env/dev/main.tf --
module "u" {
  source = "../../usecases/u"
}
-- modules/a/locals.tf --
locals {
  m = { (module.m.x) = aws_s3_bucket.this.id }
}
-- modules/a/main.tf --
resource "aws_s3_bucket" "this" {}

resource "aws_s3_bucket_policy" "this" {
  bucket = one(keys(local.m))
}
-- modules/a/tests/ok.tftest.hcl --
run "ok" {
  command = plan
}
-- usecases/u/main.tf --
module "a" {
  source = "../../modules/a"
}
