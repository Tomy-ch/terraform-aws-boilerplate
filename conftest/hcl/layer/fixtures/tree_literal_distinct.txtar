-- env/dev/main.tf --
module "u" {
  source = "../../usecases/u"
}
-- modules/a/main.tf --
resource "aws_s3_bucket" "this" {}

resource "aws_s3_bucket_policy" "this" {
  bucket = aws_s3_bucket.this.id
}
-- modules/a/tests/ok.tftest.hcl --
run "ok" {
  command = plan
}
-- modules/a/x.tf --
resource "aws_s3_bucket" "n" {
  count = 2
}

resource "aws_s3_bucket_policy" "n0" {
  bucket = aws_s3_bucket.n[0].id
}

resource "aws_s3_bucket_policy" "n1" {
  bucket = aws_s3_bucket.n[1].id
}
-- usecases/u/main.tf --
module "a" {
  source = "../../modules/a"
}
